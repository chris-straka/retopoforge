<RCC>
    <qresource prefix="/">
        <file alias="resources/dust3d-vertical.png">resources/dust3d-vertical.png</file>
        <file alias="shaders/model.vert">shaders/model.vert</file>
        <file alias="shaders/model.frag">shaders/model.frag</file>
        <file alias="shaders/model.core.vert">shaders/model.core.vert</file>
        <file alias="shaders/model.core.frag">shaders/model.core.frag</file>
        <file alias="shaders/monochrome_core.vert">shaders/monochrome_core.vert</file>
        <file alias="shaders/monochrome_core.geom">shaders/monochrome_core.geom</file>
        <file alias="shaders/monochrome_core.frag">shaders/monochrome_core.frag</file>
        <file alias="shaders/monochrome.vert">shaders/monochrome.vert</file>
        <file alias="shaders/monochrome.frag">shaders/monochrome.frag</file>
        <file alias="ACKNOWLEDGEMENTS.html">../ACKNOWLEDGEMENTS.html</file>
        <file alias="SUPPORTERS">../SUPPORTERS</file>
        <file alias="AUTHORS">../AUTHORS</file>
        <file alias="CONTRIBUTORS">../CONTRIBUTORS</file>
        <file alias="resources/crossuv.png">resources/crossuv.png</file>
    </qresource>
</RCC>
